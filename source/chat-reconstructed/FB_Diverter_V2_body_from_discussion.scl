// FB_Diverter: discussion-stage draft, NOT verified against final local FB2.
// Source BODY only; dependencies/interfaces must be exported from TIA Portal.

#ResetPulse := #ResetFault AND NOT #PrevResetFault;
#PrevResetFault := #ResetFault;

#PositionOK :=
    (#TargetB AND #DiverterExtended AND NOT #DiverterRetracted) OR
    (NOT #TargetB AND #DiverterRetracted AND NOT #DiverterExtended);

IF NOT #RunPermit THEN
    CASE #State OF
        20: #State := 10;
        30, 40: #State := 90;
    END_CASE;
END_IF;

#PositionTimeout(IN := #Enable AND #RunPermit AND (#State = 10) AND NOT #PositionOK, PT := T#3s);
#ExitTimeout(IN := #Enable AND #RunPermit AND ((#State = 30) OR (#State = 40)), PT := T#8s);

IF (#DiverterExtended AND #DiverterRetracted) OR #PositionTimeout.Q OR #ExitTimeout.Q THEN
    #State := 90;
END_IF;

IF #Enable AND (#RunPermit OR (#State = 90)) THEN
    CASE #State OF
        0:
            IF #SortRequest AND NOT #TransferActive AND NOT #ExitSensor THEN
                #TargetB := #DestinationB;
                #State := 10;
            END_IF;
        10:
            IF #PositionOK THEN #State := 20; END_IF;
        20:
            IF NOT #PositionOK THEN
                #State := 10;
            ELSIF #TransferActive THEN
                #State := 30;
            ELSIF NOT #SortRequest THEN
                #State := 90;
            END_IF;
        30:
            IF NOT #PositionOK THEN
                #State := 90;
            ELSIF #ExitSensor THEN
                #State := 40;
            END_IF;
        40:
            IF NOT #PositionOK THEN
                #State := 90;
            ELSIF NOT #ExitSensor AND NOT #TransferActive THEN
                #State := 0;
            END_IF;
        90:
            IF #ResetPulse AND NOT #RunPermit AND NOT #TransferActive
               AND NOT #ExitSensor
               AND NOT (#DiverterExtended AND #DiverterRetracted) THEN
                #State := 0;
            END_IF;
        ELSE
            #State := 90;
    END_CASE;
END_IF;

#StateCode := #State;
#Fault := (#State = 90);
#SolenoidExtend := #Enable AND #RunPermit AND #TargetB AND NOT #Fault
    AND ((#State = 10) OR (#State = 20) OR (#State = 30) OR (#State = 40));
#ReadyToRelease := #Enable AND #RunPermit AND (#State = 20) AND #PositionOK AND NOT #Fault;
