// FB_ZoneControl -- Version 2 SCL BODY as shared by the project author.
// Source-body snippet, not an importable FB interface or validated runtime build.
// Multi-Zone Conveyor -- transfer confirmation and detailed fault diagnostics

#LoadTimeout(IN := #Enable AND (#State = 10) AND NOT #PhotoEye, PT := T#8s);
#TransferTimeout(IN := #Enable AND (#State = 30), PT := T#8s);

IF #LoadTimeout.Q AND (#State <> 90) THEN
    #FaultReason := 10;
    #State := 90;
ELSIF #TransferTimeout.Q AND (#State <> 90) THEN
    #FaultReason := 20;
    #State := 90;
END_IF;

IF #Enable THEN
    CASE #State OF
        0: // EMPTY
            IF #PhotoEye THEN
                IF #ReceivePermit THEN
                    #State := 20;
                ELSE
                    #FaultReason := 50;
                    #State := 90;
                END_IF;
            ELSIF #UpstreamRequest AND #ReceivePermit THEN
                #State := 10;
            END_IF;

        10: // LOADING
            IF #PhotoEye THEN #State := 20; END_IF;

        20: // OCCUPIED
            IF NOT #PhotoEye THEN
                #FaultReason := 30;
                #State := 90;
            ELSIF #DownstreamReady AND NOT #DownstreamPhotoEye THEN
                #DownstreamSeen := FALSE;
                #State := 30;
            END_IF;

        30: // TRANSFERRING
            IF #DownstreamPhotoEye THEN
                #DownstreamSeen := TRUE;
            END_IF;
            IF NOT #PhotoEye AND #DownstreamSeen THEN
                #DownstreamSeen := FALSE;
                #State := 0;
            END_IF;

        90: // FAULT
            IF #ResetFault THEN
                #DownstreamSeen := FALSE;
                #FaultReason := 0;
                IF #PhotoEye THEN #State := 20;
                ELSE #State := 0;
                END_IF;
            END_IF;

        ELSE
            #FaultReason := 40;
            #State := 90;
    END_CASE;
END_IF;

#StateCode := #State;
#MotorForward := #Enable AND ((#State = 10) OR (#State = 30));
#ReadyToReceive := #Enable AND (#State = 0) AND NOT #PhotoEye AND #ReceivePermit;
#TransferRequest := #Enable AND (#State = 30);
#ZoneOccupied := (#State = 10) OR (#State = 20) OR (#State = 30) OR #PhotoEye;
#Fault := (#State = 90);
#FaultCode := #FaultReason;
#PrevUpstreamRequest := #UpstreamRequest;
